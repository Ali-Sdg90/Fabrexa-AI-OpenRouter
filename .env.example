# Fabrexa AI environment configuration
# Copy this file to .env, replace the placeholder values, and never commit .env.

# Telegram
# Create a bot token with @BotFather. Required.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Numeric Telegram user ID. Required when BOT_PRIVATE is true.
OWNER_ID=123456789

# Public Telegram username shown to users who request access in private mode.
# The leading @ is optional. Required when BOT_PRIVATE is true.
OWNER_USERNAME=your_telegram_username

# true: only OWNER_ID can use the bot
# false: any Telegram user can use the bot
BOT_PRIVATE=true

# Groq
# Create a key at https://console.groq.com/keys. Required.
GROQ_API_KEY=your_groq_api_key_here

# The same Groq model handles chat, session-memory analysis, and scene direction.
GROQ_MODEL=qwen/qwen3.8-27b

# Keep the official OpenAI-compatible Groq API base URL.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# none uses the model's efficient instruct mode without exposed reasoning.
GROQ_REASONING_EFFORT=none

# Generation
# Context window size in tokens. Must be a positive number.
GROQ_CONTEXT_WINDOW=131072

# Sampling temperature. Must be greater than 0 with the current config parser.
GROQ_TEMPERATURE=0.7

# Nucleus sampling value. Must be greater than 0.
GROQ_TOP_P=0.8

# Maximum number of tokens generated for one response.
GROQ_MAX_TOKENS=2048

# Minimum combined response length. The bot asks Groq to continue when a
# response ends below this target. Set to 0 to disable automatic continuation.
GROQ_MIN_RESPONSE_WORDS=250

# Maximum extra Groq requests used to reach the minimum response length.
GROQ_MAX_CONTINUATIONS=2

# Maximum number of previous conversation messages considered for each reply.
CHAT_HISTORY_MAX_MESSAGES=24

# Approximate token budget for previous conversation messages. The bot may use
# less when the system prompt, session memory, or latest message needs space.
CHAT_HISTORY_MAX_TOKENS=4096

# Per-session narrative continuity memory. It is active for every personality
# and is stored only in the current session folder.
SESSION_MEMORY_PROMPT_PATH=src/memory/session-memory-prompt.txt
SESSION_MEMORY_MAX_PROMPT_TOKENS=2048

# Final instruction appended after every selected personality prompt. Keeping it
# last gives shared response rules priority over conflicting personality text.
PERSONALITY_INSTRUCTION="Follow the selected personality and always respond with a substantial, fully developed answer."

# Requests and Telegram streaming
# Groq request timeout in milliseconds.
REQUEST_TIMEOUT=120000

# Minimum interval between Telegram streaming message edits, in milliseconds.
TELEGRAM_STREAM_EDIT_INTERVAL_MS=6000

# Automatic image continuation
# This capability is available for every personality. Each Telegram account can
# still disable it from Image Settings; the per-account default is true.
IMAGE_GENERATION_AVAILABLE=true
IMAGE_GENERATION_DEFAULT_ENABLED=true
IMAGE_GENERATION_QUEUE_MAX_SIZE=5

# Scene direction uses the character appearance, ordered session memory, and
# latest user/assistant exchange. It runs through the same GROQ_MODEL used for chat.
IMAGE_SCENE_DIRECTOR_PROMPT_PATH=src/image/scene-director.txt
# Optional private instructions appended to the scene-director system prompt.
# If this file does not exist or is empty, only the main prompt is used.
IMAGE_ADDITIONAL_SCENE_PROMPT_PATH=src/image/additional-scene-prompt.txt
IMAGE_DIRECTOR_TEMPERATURE=0.35
IMAGE_DIRECTOR_TOP_P=0.9
IMAGE_DIRECTOR_MAX_TOKENS=700
IMAGE_USER_PROMPT_HISTORY_LIMIT=50

# ComfyUI must remain local. Keep the private checkpoint filename only in .env.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=src/image/workflow_api.json
COMFYUI_CHECKPOINT_NAME=
COMFYUI_POLL_INTERVAL_MS=2000
COMFYUI_TIMEOUT_MS=240000
COMFYUI_REQUEST_TIMEOUT_MS=10000
COMFYUI_IDLE_TIMEOUT_MS=300000

# Exact node mappings for the committed API workflow.
COMFYUI_POSITIVE_PROMPT_NODE_ID=67
COMFYUI_POSITIVE_PROMPT_INPUT=text
COMFYUI_CHECKPOINT_NODE_ID=73
COMFYUI_CHECKPOINT_INPUT=ckpt_name
COMFYUI_SEED_NODE_ID=94
COMFYUI_SEED_INPUT=seed
COMFYUI_ADDITIONAL_SEED_MAPPINGS=
COMFYUI_SAVE_IMAGE_NODE_ID=84

# Logging
# normal keeps logs concise. dev-mode, debug, or verbose enables payload diagnostics.
LOG_MODE=normal

# Configured log level. Defaults to INFO.
LOG_LEVEL=INFO
