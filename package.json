{
    "name": "fabrexa-ai",
    "version": "3.4.0",
    "description": "Self-hosted Telegram AI with local Ollama replies, ComfyUI images, and session memory",
    "main": "bot.js",
    "type": "module",
    "scripts": {
        "start": "node bot.js",
        "dev": "node --env-file=.env bot.js",
        "check": "npm run check:ci && npm run check:setup && node -e \"console.log('\\n✅ All checks passed.')\"",
        "check:ci": "npm run lint && npm test",
        "check:setup": "node check-setup.js",
        "lint": "eslint bot.js \"src/**/*.js\" \"test/**/*.js\"",
        "test": "node --test"
    },
    "keywords": [
        "telegram",
        "bot",
        "ai",
        "ollama",
        "comfyui",
        "local-ai",
        "session-memory",
        "async"
    ],
    "author": "Ali Sadeghi",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.7.2",
        "dotenv": "^16.4.5",
        "telegraf": "^4.16.0"
    },
    "devDependencies": {
        "eslint": "^9.0.0"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
